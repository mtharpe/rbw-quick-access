* {
    color: #c0caf5;
}

*:focus {
    border: 4px solid #7dcfff;
}

QHBoxLayout {
    background-color: #414868;
}

QMainWindow {
    background-color: #16161e;
}

QLineEdit {
    background-color: #1a1b26;
    border: 4px solid #414868;
    border-radius: 8px;
    /* Same padding as border rad */
    padding: 8px;

    margin: 12px;
    font-size: 20px;
}

QListWidget {
    background-color: #1a1b26;
    border: 4px solid #414868;
    border-radius: 8px;
    /* Same padding as border rad */
    padding: 8px;

    margin: 12px;
    font-size: 18px;
}

QListWidget::item {
    padding: 8px;
    border-radius: 8px;
    text-overflow: hidden;
    overflow: hidden;
}   



QListWidget::item::selected {
    color: #16161e !important;
    background-color: #bb9af7;
}